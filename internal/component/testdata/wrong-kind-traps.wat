;;
;; wrong-kind-traps (#1282, item 3): every stream, future, waitable-set, waitable and subtask built-in Burroughs
;; builds, given a handle that is not of the kind it takes. Each traps in the pin, at the built-in's
;; `trap_if(not isinstance(...))` (def:copy, def:cancel_copy, def:drop, def:canon_waitable_join,
;; def:canon_waitable_set_wait, def:canon_waitable_set_poll, def:canon_waitable_set_drop, def:canon_subtask_cancel,
;; def:canon_subtask_drop), and stream-write-no-handle at def:Table.get, an index with no entry. Each export makes
;; the handles it needs with stream.new, future.new or waitable-set.new and returns the built-in's u32, or 7 after
;; one with no result. Every export is async-typed and lifted sync. Measured on wasmtime 49.0.3 (`--invoke`),
;; committed as wrong-kind-traps.reading. Assembled with `wasm-tools parse wrong-kind-traps.wat -o
;; wrong-kind-traps.wasm` (wasm-tools 1.258.0).
(component
  (core module $mm (memory (export "m") 1))
  (core instance $mi (instantiate $mm))
  (alias core export $mi "m" (core memory $m))
  (type $s (stream u8))
  (type $f (future u8))
  (core func $snew (canon stream.new $s))
  (core func $sread (canon stream.read $s async (memory $m)))
  (core func $swrite (canon stream.write $s async (memory $m)))
  (core func $scr (canon stream.cancel-read $s))
  (core func $scw (canon stream.cancel-write $s))
  (core func $sdropr (canon stream.drop-readable $s))
  (core func $sdropw (canon stream.drop-writable $s))
  (core func $fnew (canon future.new $f))
  (core func $fread (canon future.read $f async (memory $m)))
  (core func $fwrite (canon future.write $f async (memory $m)))
  (core func $fcw (canon future.cancel-write $f))
  (core func $fdropr (canon future.drop-readable $f))
  (core func $fcr (canon future.cancel-read $f))
  (core func $fdropw (canon future.drop-writable $f))
  (core func $wsnew (canon waitable-set.new))
  (core func $wsjoin (canon waitable.join))
  (core func $wswait (canon waitable-set.wait (memory $m)))
  (core func $wspoll (canon waitable-set.poll (memory $m)))
  (core func $wsdrop (canon waitable-set.drop))
  (core func $stcancel (canon subtask.cancel))
  (core func $stdrop (canon subtask.drop))
  (core module $gm
    (import "" "mem" (memory 1))
    (import "" "snew" (func $snew (result i64)))
    (import "" "sread" (func $sread (param i32 i32 i32) (result i32)))
    (import "" "swrite" (func $swrite (param i32 i32 i32) (result i32)))
    (import "" "scr" (func $scr (param i32) (result i32)))
    (import "" "scw" (func $scw (param i32) (result i32)))
    (import "" "sdropr" (func $sdropr (param i32)))
    (import "" "sdropw" (func $sdropw (param i32)))
    (import "" "fnew" (func $fnew (result i64)))
    (import "" "fread" (func $fread (param i32 i32) (result i32)))
    (import "" "fwrite" (func $fwrite (param i32 i32) (result i32)))
    (import "" "fcw" (func $fcw (param i32) (result i32)))
    (import "" "fdropr" (func $fdropr (param i32)))
    (import "" "fcr" (func $fcr (param i32) (result i32)))
    (import "" "fdropw" (func $fdropw (param i32)))
    (import "" "wsnew" (func $wsnew (result i32)))
    (import "" "wsjoin" (func $wsjoin (param i32 i32)))
    (import "" "wswait" (func $wswait (param i32 i32) (result i32)))
    (import "" "wspoll" (func $wspoll (param i32 i32) (result i32)))
    (import "" "wsdrop" (func $wsdrop (param i32)))
    (import "" "stcancel" (func $stcancel (param i32) (result i32)))
    (import "" "stdrop" (func $stdrop (param i32)))
    (global $r (mut i32) (i32.const 0))
    (global $w (mut i32) (i32.const 0))
    (func $split (param $s i64)
      (global.set $r (i32.wrap_i64 (local.get $s)))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $s) (i64.const 32)))))
    (func (export "stream-read-writable") (result i32)
      (call $split (call $snew))
      (call $sread (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "stream-write-readable") (result i32)
      (call $split (call $snew))
      (call $swrite (global.get $r) (i32.const 64) (i32.const 1)))
    (func (export "stream-cancel-read-writable") (result i32)
      (call $split (call $snew))
      (call $scr (global.get $w)))
    (func (export "stream-cancel-write-readable") (result i32)
      (call $split (call $snew))
      (call $scw (global.get $r)))
    (func (export "stream-drop-readable-writable") (result i32)
      (call $split (call $snew))
      (call $sdropr (global.get $w))
      (i32.const 7))
    (func (export "stream-drop-writable-readable") (result i32)
      (call $split (call $snew))
      (call $sdropw (global.get $r))
      (i32.const 7))
    (func (export "stream-write-no-handle") (result i32)
      (call $swrite (i32.const 99) (i32.const 64) (i32.const 1)))
    (func (export "future-read-writable") (result i32)
      (call $split (call $fnew))
      (call $fread (global.get $w) (i32.const 64)))
    (func (export "future-read-stream") (result i32)
      (call $split (call $snew))
      (call $fread (global.get $r) (i32.const 64)))
    (func (export "future-write-readable") (result i32)
      (call $split (call $fnew))
      (call $fwrite (global.get $r) (i32.const 64)))
    (func (export "future-cancel-write-readable") (result i32)
      (call $split (call $fnew))
      (call $fcw (global.get $r)))
    (func (export "future-drop-readable-writable") (result i32)
      (call $split (call $fnew))
      (call $fdropr (global.get $w))
      (i32.const 7))
    (func (export "future-cancel-read-writable") (result i32)
      (call $split (call $fnew))
      (call $fcr (global.get $w)))
    (func (export "future-drop-writable-readable") (result i32)
      (call $split (call $fnew))
      (call $fdropw (global.get $r))
      (i32.const 7))
    (func (export "join-set-as-waitable") (result i32)
      (call $wsjoin (call $wsnew) (call $wsnew))
      (i32.const 7))
    (func (export "join-end-as-set") (result i32)
      (call $split (call $snew))
      (call $wsjoin (global.get $r) (global.get $w))
      (i32.const 7))
    (func (export "wait-end") (result i32)
      (call $split (call $snew))
      (call $wswait (global.get $r) (i32.const 64)))
    (func (export "poll-end") (result i32)
      (call $split (call $snew))
      (call $wspoll (global.get $r) (i32.const 64)))
    (func (export "set-drop-end") (result i32)
      (call $split (call $snew))
      (call $wsdrop (global.get $r))
      (i32.const 7))
    (func (export "subtask-cancel-end") (result i32)
      (call $split (call $snew))
      (call $stcancel (global.get $r)))
    (func (export "subtask-drop-end") (result i32)
      (call $split (call $snew))
      (call $stdrop (global.get $r))
      (i32.const 7)))
  (core instance $gi (instantiate $gm (with "" (instance (export "mem" (memory $m))
    (export "snew" (func $snew)) (export "sread" (func $sread)) (export "swrite" (func $swrite))
    (export "scr" (func $scr)) (export "scw" (func $scw)) (export "sdropr" (func $sdropr)) (export "sdropw" (func $sdropw))
    (export "fnew" (func $fnew)) (export "fread" (func $fread)) (export "fwrite" (func $fwrite))
    (export "fcw" (func $fcw)) (export "fdropr" (func $fdropr)) (export "fcr" (func $fcr)) (export "fdropw" (func $fdropw))
    (export "wsnew" (func $wsnew)) (export "wsjoin" (func $wsjoin)) (export "wswait" (func $wswait))
    (export "wspoll" (func $wspoll)) (export "wsdrop" (func $wsdrop))
    (export "stcancel" (func $stcancel)) (export "stdrop" (func $stdrop))))))
  (type $at (func async (result u32)))
  (func (export "stream-read-writable") (type $at) (canon lift (core func $gi "stream-read-writable")))
  (func (export "stream-write-readable") (type $at) (canon lift (core func $gi "stream-write-readable")))
  (func (export "stream-cancel-read-writable") (type $at) (canon lift (core func $gi "stream-cancel-read-writable")))
  (func (export "stream-cancel-write-readable") (type $at) (canon lift (core func $gi "stream-cancel-write-readable")))
  (func (export "stream-drop-readable-writable") (type $at) (canon lift (core func $gi "stream-drop-readable-writable")))
  (func (export "stream-drop-writable-readable") (type $at) (canon lift (core func $gi "stream-drop-writable-readable")))
  (func (export "stream-write-no-handle") (type $at) (canon lift (core func $gi "stream-write-no-handle")))
  (func (export "future-read-writable") (type $at) (canon lift (core func $gi "future-read-writable")))
  (func (export "future-read-stream") (type $at) (canon lift (core func $gi "future-read-stream")))
  (func (export "future-write-readable") (type $at) (canon lift (core func $gi "future-write-readable")))
  (func (export "future-cancel-write-readable") (type $at) (canon lift (core func $gi "future-cancel-write-readable")))
  (func (export "future-drop-readable-writable") (type $at) (canon lift (core func $gi "future-drop-readable-writable")))
  (func (export "future-cancel-read-writable") (type $at) (canon lift (core func $gi "future-cancel-read-writable")))
  (func (export "future-drop-writable-readable") (type $at) (canon lift (core func $gi "future-drop-writable-readable")))
  (func (export "join-set-as-waitable") (type $at) (canon lift (core func $gi "join-set-as-waitable")))
  (func (export "join-end-as-set") (type $at) (canon lift (core func $gi "join-end-as-set")))
  (func (export "wait-end") (type $at) (canon lift (core func $gi "wait-end")))
  (func (export "poll-end") (type $at) (canon lift (core func $gi "poll-end")))
  (func (export "set-drop-end") (type $at) (canon lift (core func $gi "set-drop-end")))
  (func (export "subtask-cancel-end") (type $at) (canon lift (core func $gi "subtask-cancel-end")))
  (func (export "subtask-drop-end") (type $at) (canon lift (core func $gi "subtask-drop-end"))))
