;;
;; stream-typed-copy (ADR 0124, #1275): a guest copying typed elements through its own stream, both orderings. A
;; copy strides by the element's size (def:ReadableGuestBuffer.read, def:load_list_from_valid_range), and a float's
;; NaN is canonicalised as the codec's lift does. Each export runs one sequence and returns one u32, so every
;; quantity is its own row in stream-typed-copy.reading. Memory: the writer's elements at 64, the reader's buffer
;; at 128, zeroed. Type 1 and type 2 are both `stream u32`, which the pin's `end.t != stream_or_future_t.t` (def:copy)
;; reads as one type.
;; Assembled with `wasm-tools parse stream-typed-copy.wat -o stream-typed-copy.wasm` (wasm-tools 1.258.0).
(component
  (core module $mm (memory (export "m") 1))
  (core instance $mi (instantiate $mm))
  (alias core export $mi "m" (core memory $m))
  (type $u8s (stream u8))
  (type $u32s (stream u32))
  (type $u32t (stream u32))
  (type $f32s (stream f32))
  (type $f64s (stream f64))
  (core func $new8 (canon stream.new $u8s))
  (core func $write8 (canon stream.write $u8s async (memory $m)))
  (core func $read8 (canon stream.read $u8s async (memory $m)))
  (core func $new32 (canon stream.new $u32s))
  (core func $write32 (canon stream.write $u32s async (memory $m)))
  (core func $read32 (canon stream.read $u32s async (memory $m)))
  (core func $read32t (canon stream.read $u32t async (memory $m)))
  (core func $newf32 (canon stream.new $f32s))
  (core func $writef32 (canon stream.write $f32s async (memory $m)))
  (core func $readf32 (canon stream.read $f32s async (memory $m)))
  (core func $newf64 (canon stream.new $f64s))
  (core func $writef64 (canon stream.write $f64s async (memory $m)))
  (core func $readf64 (canon stream.read $f64s async (memory $m)))
  (core module $gm
    (import "" "mem" (memory 1))
    (import "" "new8" (func $new8 (result i64)))
    (import "" "write8" (func $write8 (param i32 i32 i32) (result i32)))
    (import "" "read8" (func $read8 (param i32 i32 i32) (result i32)))
    (import "" "new32" (func $new32 (result i64)))
    (import "" "write32" (func $write32 (param i32 i32 i32) (result i32)))
    (import "" "read32" (func $read32 (param i32 i32 i32) (result i32)))
    (import "" "read32t" (func $read32t (param i32 i32 i32) (result i32)))
    (import "" "newf32" (func $newf32 (result i64)))
    (import "" "writef32" (func $writef32 (param i32 i32 i32) (result i32)))
    (import "" "readf32" (func $readf32 (param i32 i32 i32) (result i32)))
    (import "" "newf64" (func $newf64 (result i64)))
    (import "" "writef64" (func $writef64 (param i32 i32 i32) (result i32)))
    (import "" "readf64" (func $readf64 (param i32 i32 i32) (result i32)))
    (global $r (mut i32) (i32.const 0))
    (global $w (mut i32) (i32.const 0))
    (func $split (param $s i64)
      (global.set $r (i32.wrap_i64 (local.get $s)))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $s) (i64.const 32)))))
    (func $words
      (i32.store (i32.const 64) (i32.const 0x11223344))
      (i32.store (i32.const 68) (i32.const 0x55667788))
      (i32.store (i32.const 72) (i32.const 0x99aabbcc)))
    ;; write 3 u32 (parks), then read 4: the read is the second arriver.
    (func $u32wf (result i32)
      (call $words)
      (call $split (call $new32))
      (drop (call $write32 (global.get $w) (i32.const 64) (i32.const 3)))
      (call $read32 (global.get $r) (i32.const 128) (i32.const 4)))
    ;; read 4 (parks), then write 3: the write is the second arriver.
    (func $u32rf (result i32)
      (call $words)
      (call $split (call $new32))
      (drop (call $read32 (global.get $r) (i32.const 128) (i32.const 4)))
      (call $write32 (global.get $w) (i32.const 64) (i32.const 3)))
    (func (export "u32-wf-result") (result i32) (call $u32wf))
    (func (export "u32-wf-w0") (result i32) (drop (call $u32wf)) (i32.load (i32.const 128)))
    (func (export "u32-wf-w1") (result i32) (drop (call $u32wf)) (i32.load (i32.const 132)))
    (func (export "u32-wf-w2") (result i32) (drop (call $u32wf)) (i32.load (i32.const 136)))
    (func (export "u32-wf-w3") (result i32) (drop (call $u32wf)) (i32.load (i32.const 140)))
    (func (export "u32-rf-result") (result i32) (call $u32rf))
    (func (export "u32-rf-w0") (result i32) (drop (call $u32rf)) (i32.load (i32.const 128)))
    (func (export "u32-rf-w2") (result i32) (drop (call $u32rf)) (i32.load (i32.const 136)))
    (func (export "u32-rf-w3") (result i32) (drop (call $u32rf)) (i32.load (i32.const 140)))
    ;; write 3, read 2: the copy is the smaller side, in elements.
    (func (export "u32-partial-result") (result i32)
      (call $words)
      (call $split (call $new32))
      (drop (call $write32 (global.get $w) (i32.const 64) (i32.const 3)))
      (call $read32 (global.get $r) (i32.const 128) (i32.const 2)))
    (func (export "u32-partial-w2") (result i32)
      (call $words)
      (call $split (call $new32))
      (drop (call $write32 (global.get $w) (i32.const 64) (i32.const 3)))
      (drop (call $read32 (global.get $r) (i32.const 128) (i32.const 2)))
      (i32.load (i32.const 136)))
    ;; the read names type 2, structurally the end's type 1.
    (func (export "u32-equal-type-result") (result i32)
      (call $words)
      (call $split (call $new32))
      (drop (call $write32 (global.get $w) (i32.const 64) (i32.const 3)))
      (call $read32t (global.get $r) (i32.const 128) (i32.const 4)))
    ;; f32: a non-canonical NaN, then 1.5.
    (func $f32wf
      (i32.store (i32.const 64) (i32.const 0x7fc00001))
      (i32.store (i32.const 68) (i32.const 0x3fc00000))
      (call $split (call $newf32))
      (drop (call $writef32 (global.get $w) (i32.const 64) (i32.const 2)))
      (drop (call $readf32 (global.get $r) (i32.const 128) (i32.const 2))))
    (func $f32rf
      (i32.store (i32.const 64) (i32.const 0x7fc00001))
      (i32.store (i32.const 68) (i32.const 0x3fc00000))
      (call $split (call $newf32))
      (drop (call $readf32 (global.get $r) (i32.const 128) (i32.const 2)))
      (drop (call $writef32 (global.get $w) (i32.const 64) (i32.const 2))))
    (func (export "f32-wf-w0") (result i32) (call $f32wf) (i32.load (i32.const 128)))
    (func (export "f32-wf-w1") (result i32) (call $f32wf) (i32.load (i32.const 132)))
    (func (export "f32-rf-w0") (result i32) (call $f32rf) (i32.load (i32.const 128)))
    ;; f64: a non-canonical NaN; its low and high words.
    (func $f64wf
      (i64.store (i32.const 64) (i64.const 0x7ff8000000000001))
      (call $split (call $newf64))
      (drop (call $writef64 (global.get $w) (i32.const 64) (i32.const 1)))
      (drop (call $readf64 (global.get $r) (i32.const 128) (i32.const 1))))
    (func (export "f64-wf-lo") (result i32) (call $f64wf) (i32.load (i32.const 128)))
    (func (export "f64-wf-hi") (result i32) (call $f64wf) (i32.load (i32.const 132)))
    ;; u8, the control: 3 bytes.
    (func $u8wf (result i32)
      (call $words)
      (call $split (call $new8))
      (drop (call $write8 (global.get $w) (i32.const 64) (i32.const 3)))
      (call $read8 (global.get $r) (i32.const 128) (i32.const 4)))
    (func (export "u8-wf-result") (result i32) (call $u8wf))
    (func (export "u8-wf-w0") (result i32) (drop (call $u8wf)) (i32.load (i32.const 128))))
  (core instance $gi (instantiate $gm
    (with "" (instance (export "mem" (memory $m))
      (export "new8" (func $new8)) (export "write8" (func $write8)) (export "read8" (func $read8))
      (export "new32" (func $new32)) (export "write32" (func $write32)) (export "read32" (func $read32))
      (export "read32t" (func $read32t))
      (export "newf32" (func $newf32)) (export "writef32" (func $writef32)) (export "readf32" (func $readf32))
      (export "newf64" (func $newf64)) (export "writef64" (func $writef64)) (export "readf64" (func $readf64))))))
  (func (export "u32-wf-result") (result u32) (canon lift (core func $gi "u32-wf-result")))
  (func (export "u32-wf-w0") (result u32) (canon lift (core func $gi "u32-wf-w0")))
  (func (export "u32-wf-w1") (result u32) (canon lift (core func $gi "u32-wf-w1")))
  (func (export "u32-wf-w2") (result u32) (canon lift (core func $gi "u32-wf-w2")))
  (func (export "u32-wf-w3") (result u32) (canon lift (core func $gi "u32-wf-w3")))
  (func (export "u32-rf-result") (result u32) (canon lift (core func $gi "u32-rf-result")))
  (func (export "u32-rf-w0") (result u32) (canon lift (core func $gi "u32-rf-w0")))
  (func (export "u32-rf-w2") (result u32) (canon lift (core func $gi "u32-rf-w2")))
  (func (export "u32-rf-w3") (result u32) (canon lift (core func $gi "u32-rf-w3")))
  (func (export "u32-partial-result") (result u32) (canon lift (core func $gi "u32-partial-result")))
  (func (export "u32-partial-w2") (result u32) (canon lift (core func $gi "u32-partial-w2")))
  (func (export "u32-equal-type-result") (result u32) (canon lift (core func $gi "u32-equal-type-result")))
  (func (export "f32-wf-w0") (result u32) (canon lift (core func $gi "f32-wf-w0")))
  (func (export "f32-wf-w1") (result u32) (canon lift (core func $gi "f32-wf-w1")))
  (func (export "f32-rf-w0") (result u32) (canon lift (core func $gi "f32-rf-w0")))
  (func (export "f64-wf-lo") (result u32) (canon lift (core func $gi "f64-wf-lo")))
  (func (export "f64-wf-hi") (result u32) (canon lift (core func $gi "f64-wf-hi")))
  (func (export "u8-wf-result") (result u32) (canon lift (core func $gi "u8-wf-result")))
  (func (export "u8-wf-w0") (result u32) (canon lift (core func $gi "u8-wf-w0"))))
