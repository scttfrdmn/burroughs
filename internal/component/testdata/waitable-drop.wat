;; Copyright 2026 Scott Friedman. SPDX-License-Identifier: Apache-2.0
;;
;; waitable-drop (grave #1296): a dropped waitable leaves its waitable set, as def:Waitable.drop does
;; (`self.join(None)`), so the set can then be dropped. Each export joins one kind of waitable to a fresh set, drops
;; it, then drops the set, and returns 1 if it got that far. `still-joined` is the control: it drops the set with
;; its member still joined, which traps on both engines, so the rows above it are not passing for want of a check.
;; Every export is async-typed and lifted sync, so `subtask`'s sync waitable-set.wait is legal (grave #1267).
;; Measured on wasmtime 49.0.3 (`--invoke`), committed as waitable-drop.reading.
;; Assembled with `wasm-tools parse waitable-drop.wat -o waitable-drop.wasm` (wasm-tools 1.258.0).
(component
  (import "wasi:clocks/monotonic-clock@0.3.0" (instance $mc
    (export "wait-for" (func async (param "how-long" u64)))))
  (alias export $mc "wait-for" (func $wf))
  (core module $mm (memory (export "m") 1))
  (core instance $mi (instantiate $mm))
  (alias core export $mi "m" (core memory $m))
  (type $s (stream u8))
  (type $f (future u8))
  (core func $wfa (canon lower (func $wf) async))
  (core func $snew (canon stream.new $s))
  (core func $sdropr (canon stream.drop-readable $s))
  (core func $sdropw (canon stream.drop-writable $s))
  (core func $fnew (canon future.new $f))
  (core func $fdropr (canon future.drop-readable $f))
  (core func $wsnew (canon waitable-set.new))
  (core func $wsjoin (canon waitable.join))
  (core func $wswait (canon waitable-set.wait (memory $m)))
  (core func $wsdrop (canon waitable-set.drop))
  (core func $stdrop (canon subtask.drop))
  (core module $gm
    (import "" "mem" (memory 1))
    (import "" "wfa" (func $wfa (param i64) (result i32)))
    (import "" "snew" (func $snew (result i64)))
    (import "" "sdropr" (func $sdropr (param i32)))
    (import "" "sdropw" (func $sdropw (param i32)))
    (import "" "fnew" (func $fnew (result i64)))
    (import "" "fdropr" (func $fdropr (param i32)))
    (import "" "wsnew" (func $wsnew (result i32)))
    (import "" "wsjoin" (func $wsjoin (param i32 i32)))
    (import "" "wswait" (func $wswait (param i32 i32) (result i32)))
    (import "" "wsdrop" (func $wsdrop (param i32)))
    (import "" "stdrop" (func $stdrop (param i32)))
    (func (export "stream-readable") (result i32) (local $p i64) (local $ws i32)
      (local.set $p (call $snew))
      (local.set $ws (call $wsnew))
      (call $wsjoin (i32.wrap_i64 (local.get $p)) (local.get $ws))
      (call $sdropr (i32.wrap_i64 (local.get $p)))
      (call $sdropw (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
      (call $wsdrop (local.get $ws))
      (i32.const 1))
    (func (export "stream-writable") (result i32) (local $p i64) (local $ws i32)
      (local.set $p (call $snew))
      (local.set $ws (call $wsnew))
      (call $wsjoin (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))) (local.get $ws))
      (call $sdropw (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
      (call $sdropr (i32.wrap_i64 (local.get $p)))
      (call $wsdrop (local.get $ws))
      (i32.const 1))
    (func (export "future-readable") (result i32) (local $p i64) (local $ws i32)
      (local.set $p (call $fnew))
      (local.set $ws (call $wsnew))
      (call $wsjoin (i32.wrap_i64 (local.get $p)) (local.get $ws))
      (call $fdropr (i32.wrap_i64 (local.get $p)))
      (call $wsdrop (local.get $ws))
      (i32.const 1))
    ;; wait-for(50ms) async-lowered comes back STARTED with a subtask; it is joined, waited on (sync), dropped,
    ;; and then the set is dropped. A RETURNED-inline answer (no subtask) would return 2, never seen on either engine.
    (func (export "subtask") (result i32) (local $st i32) (local $ws i32)
      (local.set $st (call $wfa (i64.const 50000000)))
      (if (i32.eq (i32.and (local.get $st) (i32.const 0xf)) (i32.const 2)) (then (return (i32.const 2))))
      (local.set $ws (call $wsnew))
      (call $wsjoin (i32.shr_u (local.get $st) (i32.const 4)) (local.get $ws))
      (drop (call $wswait (local.get $ws) (i32.const 64)))
      (call $stdrop (i32.shr_u (local.get $st) (i32.const 4)))
      (call $wsdrop (local.get $ws))
      (i32.const 1))
    (func (export "still-joined") (result i32) (local $p i64) (local $ws i32)
      (local.set $p (call $snew))
      (local.set $ws (call $wsnew))
      (call $wsjoin (i32.wrap_i64 (local.get $p)) (local.get $ws))
      (call $wsdrop (local.get $ws))
      (i32.const 1)))
  (core instance $gi (instantiate $gm (with "" (instance (export "mem" (memory $m))
    (export "wfa" (func $wfa)) (export "snew" (func $snew)) (export "sdropr" (func $sdropr))
    (export "sdropw" (func $sdropw)) (export "fnew" (func $fnew)) (export "fdropr" (func $fdropr))
    (export "wsnew" (func $wsnew)) (export "wsjoin" (func $wsjoin)) (export "wswait" (func $wswait))
    (export "wsdrop" (func $wsdrop)) (export "stdrop" (func $stdrop))))))
  (type $at (func async (result u32)))
  (func (export "stream-readable") (type $at) (canon lift (core func $gi "stream-readable")))
  (func (export "stream-writable") (type $at) (canon lift (core func $gi "stream-writable")))
  (func (export "future-readable") (type $at) (canon lift (core func $gi "future-readable")))
  (func (export "subtask") (type $at) (canon lift (core func $gi "subtask")))
  (func (export "still-joined") (type $at) (canon lift (core func $gi "still-joined"))))
