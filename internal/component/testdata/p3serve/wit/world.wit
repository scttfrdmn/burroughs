// The world p3serve implements (#1385, ADR 0137): wasi:http@0.3's handler, exported, over its types, its client
// (the send row: serve grants outgoing HTTP) and the monotonic clock. build.sh stages this beside the pinned WASI
// 0.3.0 WIT the nightly's std vendors (wasip3-0.8.0+wasi-0.3.0), as wit/deps, so the bindings are generated from the
// WIT p3http's are.
package burroughs:p3serve;

world p3serve {
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  export wasi:http/handler@0.3.0;
}
