;;
;; stream-typed-traps (ADR 0124, #1275): the pin's traps on a typed stream, one export each, with the control that
;; does not trap beside each. Every export makes its stream with `stream.new` and returns the last built-in's u32, or
;; 7 after a drop.
;;   - def:GuestBuffer: a buffer not aligned to its element, or past the end of memory, traps when its length is
;;     not 0; one longer than MAX_LENGTH traps whatever its element.
;;   - def:copy: an end used through a built-in naming another element type traps (`end.t != stream_or_future_t.t`).
;;   - def:End.copy: a copy between two ends of one instance traps unless the element is a number, at the copy and
;;     not at the write that parks before it.
;; Memory is one page (65536 bytes). Assembled with `wasm-tools parse stream-typed-traps.wat -o
;; stream-typed-traps.wasm` (wasm-tools 1.258.0).
(component
  (core module $mm (memory (export "m") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 1024)))
  (core instance $mi (instantiate $mm))
  (alias core export $mi "m" (core memory $m))
  (alias core export $mi "realloc" (core func $realloc))
  (type $R (resource (rep i32)))
  (type $u8s (stream u8))
  (type $u32s (stream u32))
  (type $strs (stream string))
  (type $owns (stream (own $R)))
  (core func $new32 (canon stream.new $u32s))
  (core func $write32 (canon stream.write $u32s async (memory $m)))
  (core func $read32 (canon stream.read $u32s async (memory $m)))
  (core func $write8 (canon stream.write $u8s async (memory $m)))
  (core func $read8 (canon stream.read $u8s async (memory $m)))
  (core func $cancelw8 (canon stream.cancel-write $u8s))
  (core func $dropw8 (canon stream.drop-writable $u8s))
  (core func $dropr8 (canon stream.drop-readable $u8s))
  (core func $newstr (canon stream.new $strs))
  (core func $writestr (canon stream.write $strs async (memory $m)))
  (core func $readstr (canon stream.read $strs async (memory $m) (realloc $realloc)))
  (core func $newown (canon stream.new $owns))
  (core func $writeown (canon stream.write $owns async (memory $m)))
  (core func $readown (canon stream.read $owns async (memory $m)))
  (core module $gm
    (import "" "mem" (memory 1))
    (import "" "new32" (func $new32 (result i64)))
    (import "" "write32" (func $write32 (param i32 i32 i32) (result i32)))
    (import "" "read32" (func $read32 (param i32 i32 i32) (result i32)))
    (import "" "write8" (func $write8 (param i32 i32 i32) (result i32)))
    (import "" "read8" (func $read8 (param i32 i32 i32) (result i32)))
    (import "" "cancelw8" (func $cancelw8 (param i32) (result i32)))
    (import "" "dropw8" (func $dropw8 (param i32)))
    (import "" "dropr8" (func $dropr8 (param i32)))
    (import "" "newstr" (func $newstr (result i64)))
    (import "" "writestr" (func $writestr (param i32 i32 i32) (result i32)))
    (import "" "readstr" (func $readstr (param i32 i32 i32) (result i32)))
    (import "" "newown" (func $newown (result i64)))
    (import "" "writeown" (func $writeown (param i32 i32 i32) (result i32)))
    (import "" "readown" (func $readown (param i32 i32 i32) (result i32)))
    (global $r (mut i32) (i32.const 0))
    (global $w (mut i32) (i32.const 0))
    (func $split (param $s i64)
      (global.set $r (i32.wrap_i64 (local.get $s)))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $s) (i64.const 32)))))
    ;; GuestBuffer's alignment: a u32 buffer at 2.
    (func (export "misaligned-read") (result i32)
      (call $split (call $new32))
      (call $read32 (global.get $r) (i32.const 2) (i32.const 1)))
    (func (export "misaligned-read-zero") (result i32)
      (call $split (call $new32))
      (call $read32 (global.get $r) (i32.const 2) (i32.const 0)))
    (func (export "misaligned-write") (result i32)
      (call $split (call $new32))
      (call $write32 (global.get $w) (i32.const 2) (i32.const 1)))
    (func (export "aligned-read") (result i32)
      (call $split (call $new32))
      (call $read32 (global.get $r) (i32.const 4) (i32.const 1)))
    ;; GuestBuffer's range: two u32 at 65532 end 4 bytes past memory; at 65528 they end at it.
    (func (export "out-of-range-write") (result i32)
      (call $split (call $new32))
      (call $write32 (global.get $w) (i32.const 65532) (i32.const 2)))
    (func (export "out-of-range-read") (result i32)
      (call $split (call $new32))
      (call $read32 (global.get $r) (i32.const 65532) (i32.const 2)))
    (func (export "in-range-write") (result i32)
      (call $split (call $new32))
      (call $write32 (global.get $w) (i32.const 65528) (i32.const 2)))
    (func (export "in-range-read") (result i32)
      (call $split (call $new32))
      (call $read32 (global.get $r) (i32.const 65528) (i32.const 2)))
    ;; GuestBuffer's MAX_LENGTH: 2^28 elements is one past it.
    (func (export "max-length-write") (result i32)
      (call $split (call $new32))
      (call $write32 (global.get $w) (i32.const 0) (i32.const 0x10000000)))
    ;; copy's end type: a stream<u32> end through a stream<u8> built-in.
    (func (export "mismatch-write") (result i32)
      (call $split (call $new32))
      (call $write8 (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "mismatch-read") (result i32)
      (call $split (call $new32))
      (call $read8 (global.get $r) (i32.const 64) (i32.const 1)))
    (func (export "mismatch-cancel-write") (result i32)
      (call $split (call $new32))
      (drop (call $write32 (global.get $w) (i32.const 64) (i32.const 1)))
      (call $cancelw8 (global.get $w)))
    (func (export "mismatch-drop-writable") (result i32)
      (call $split (call $new32))
      (call $dropw8 (global.get $w))
      (i32.const 7))
    (func (export "mismatch-drop-readable") (result i32)
      (call $split (call $new32))
      (call $dropr8 (global.get $r))
      (i32.const 7))
    ;; End.copy's element rule: a string, then an own, within one instance. The trap precedes the buffer's read,
    ;; so the own's element is the word 1, a handle no table holds, and $R needs no `resource.new` (a guest-defined
    ;; resource's built-ins are #1251's).
    (func (export "string-write") (result i32)
      (i32.store (i32.const 64) (i32.const 256))
      (i32.store (i32.const 68) (i32.const 0))
      (call $split (call $newstr))
      (call $writestr (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "string-copy") (result i32)
      (i32.store (i32.const 64) (i32.const 256))
      (i32.store (i32.const 68) (i32.const 0))
      (call $split (call $newstr))
      (drop (call $writestr (global.get $w) (i32.const 64) (i32.const 1)))
      (call $readstr (global.get $r) (i32.const 128) (i32.const 1)))
    (func (export "string-copy-read-first") (result i32)
      (i32.store (i32.const 64) (i32.const 256))
      (i32.store (i32.const 68) (i32.const 0))
      (call $split (call $newstr))
      (drop (call $readstr (global.get $r) (i32.const 128) (i32.const 1)))
      (call $writestr (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "own-write") (result i32)
      (i32.store (i32.const 64) (i32.const 1))
      (call $split (call $newown))
      (call $writeown (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "own-copy") (result i32)
      (i32.store (i32.const 64) (i32.const 1))
      (call $split (call $newown))
      (drop (call $writeown (global.get $w) (i32.const 64) (i32.const 1)))
      (call $readown (global.get $r) (i32.const 128) (i32.const 1))))
  (core instance $gi (instantiate $gm
    (with "" (instance (export "mem" (memory $m))
      (export "new32" (func $new32)) (export "write32" (func $write32)) (export "read32" (func $read32))
      (export "write8" (func $write8)) (export "read8" (func $read8)) (export "cancelw8" (func $cancelw8))
      (export "dropw8" (func $dropw8)) (export "dropr8" (func $dropr8))
      (export "newstr" (func $newstr)) (export "writestr" (func $writestr)) (export "readstr" (func $readstr))
      (export "newown" (func $newown)) (export "writeown" (func $writeown)) (export "readown" (func $readown))))))
  (func (export "misaligned-read") (result u32) (canon lift (core func $gi "misaligned-read")))
  (func (export "misaligned-read-zero") (result u32) (canon lift (core func $gi "misaligned-read-zero")))
  (func (export "misaligned-write") (result u32) (canon lift (core func $gi "misaligned-write")))
  (func (export "aligned-read") (result u32) (canon lift (core func $gi "aligned-read")))
  (func (export "out-of-range-write") (result u32) (canon lift (core func $gi "out-of-range-write")))
  (func (export "out-of-range-read") (result u32) (canon lift (core func $gi "out-of-range-read")))
  (func (export "in-range-write") (result u32) (canon lift (core func $gi "in-range-write")))
  (func (export "in-range-read") (result u32) (canon lift (core func $gi "in-range-read")))
  (func (export "max-length-write") (result u32) (canon lift (core func $gi "max-length-write")))
  (func (export "mismatch-write") (result u32) (canon lift (core func $gi "mismatch-write")))
  (func (export "mismatch-read") (result u32) (canon lift (core func $gi "mismatch-read")))
  (func (export "mismatch-cancel-write") (result u32) (canon lift (core func $gi "mismatch-cancel-write")))
  (func (export "mismatch-drop-writable") (result u32) (canon lift (core func $gi "mismatch-drop-writable")))
  (func (export "mismatch-drop-readable") (result u32) (canon lift (core func $gi "mismatch-drop-readable")))
  (func (export "string-write") (result u32) (canon lift (core func $gi "string-write")))
  (func (export "string-copy") (result u32) (canon lift (core func $gi "string-copy")))
  (func (export "string-copy-read-first") (result u32) (canon lift (core func $gi "string-copy-read-first")))
  (func (export "own-write") (result u32) (canon lift (core func $gi "own-write")))
  (func (export "own-copy") (result u32) (canon lift (core func $gi "own-copy"))))
