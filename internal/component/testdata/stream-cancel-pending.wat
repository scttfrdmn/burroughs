;;
;; stream-cancel-pending (#1282, item 2): a cancel of a stream copy that has completed but whose event has not been
;; taken. The end is COPYING until its event is taken, so def:cancel_copy does not trap; it takes the pending event,
;; which reads CANCELLED with the copy's progress (DROPPED if the other end has gone). One stream<u8> per export:
;;   - `$wfirst`: a write of 4 parks, then a read of 2 in the same task completes it inline (32: COMPLETED,
;;     progress 2), leaving the writer's event pending; `$rfirst` is its mirror, a read of 4 parked and a write of 2.
;;   - cancel-*-after-copy returns the cancel's result; -reader-dropped/-writer-dropped drop the other end first.
;;   - poll-after-cancel-* joins the cancelled end to a fresh set and polls it, returning the code | (payload << 8):
;;     0, no second event. poll-without-cancel-* is its control: the same poll with no cancel sees the pending
;;     event (STREAM_WRITE 3 or STREAM_READ 2, payload 32).
;;   - write-after-cancel-write writes again on the cancelled end, which is IDLE, so the write parks (BLOCKED).
;;   - cancel-write-idle cancels a write that never started, which traps on both engines: the control that the
;;     cancels above are not passing for want of a state check.
;; Every export is async-typed and lifted sync. Measured on wasmtime 49.0.3 (`--invoke`), committed as
;; stream-cancel-pending.reading. Assembled with `wasm-tools parse stream-cancel-pending.wat -o
;; stream-cancel-pending.wasm` (wasm-tools 1.258.0).
(component
  (core module $mm (memory (export "m") 1))
  (core instance $mi (instantiate $mm))
  (alias core export $mi "m" (core memory $m))
  (type $s (stream u8))
  (core func $snew (canon stream.new $s))
  (core func $sread (canon stream.read $s async (memory $m)))
  (core func $swrite (canon stream.write $s async (memory $m)))
  (core func $cr (canon stream.cancel-read $s))
  (core func $cw (canon stream.cancel-write $s))
  (core func $dropr (canon stream.drop-readable $s))
  (core func $dropw (canon stream.drop-writable $s))
  (core func $wsnew (canon waitable-set.new))
  (core func $wsjoin (canon waitable.join))
  (core func $wspoll (canon waitable-set.poll (memory $m)))
  (core module $gm
    (import "" "mem" (memory 1))
    (import "" "snew" (func $snew (result i64)))
    (import "" "sread" (func $sread (param i32 i32 i32) (result i32)))
    (import "" "swrite" (func $swrite (param i32 i32 i32) (result i32)))
    (import "" "cr" (func $cr (param i32) (result i32)))
    (import "" "cw" (func $cw (param i32) (result i32)))
    (import "" "dropr" (func $dropr (param i32)))
    (import "" "dropw" (func $dropw (param i32)))
    (import "" "wsnew" (func $wsnew (result i32)))
    (import "" "wsjoin" (func $wsjoin (param i32 i32)))
    (import "" "wspoll" (func $wspoll (param i32 i32) (result i32)))
    (global $r (mut i32) (i32.const 0))
    (global $w (mut i32) (i32.const 0))
    (func $split (param $s i64)
      (global.set $r (i32.wrap_i64 (local.get $s)))
      (global.set $w (i32.wrap_i64 (i64.shr_u (local.get $s) (i64.const 32)))))
    ;; A write of 4 parks; a read of 2 completes it inline. Returns the read's result.
    (func $wfirst (result i32)
      (call $split (call $snew))
      (drop (call $swrite (global.get $w) (i32.const 64) (i32.const 4)))
      (call $sread (global.get $r) (i32.const 128) (i32.const 2)))
    ;; A read of 4 parks; a write of 2 completes it inline. Returns the write's result.
    (func $rfirst (result i32)
      (call $split (call $snew))
      (drop (call $sread (global.get $r) (i32.const 128) (i32.const 4)))
      (call $swrite (global.get $w) (i32.const 64) (i32.const 2)))
    ;; Join h to a fresh set and poll it: the event code | (its payload << 8).
    (func $pollone (param $h i32) (result i32) (local $ws i32) (local $code i32)
      (local.set $ws (call $wsnew))
      (call $wsjoin (local.get $h) (local.get $ws))
      (local.set $code (call $wspoll (local.get $ws) (i32.const 256)))
      (i32.or (local.get $code) (i32.shl (i32.load (i32.const 260)) (i32.const 8))))
    (func (export "inline-read") (result i32) (call $wfirst))
    (func (export "cancel-write-after-copy") (result i32)
      (drop (call $wfirst))
      (call $cw (global.get $w)))
    (func (export "poll-after-cancel-write") (result i32)
      (drop (call $wfirst))
      (drop (call $cw (global.get $w)))
      (call $pollone (global.get $w)))
    (func (export "poll-without-cancel-write") (result i32)
      (drop (call $wfirst))
      (call $pollone (global.get $w)))
    (func (export "cancel-write-after-copy-reader-dropped") (result i32)
      (drop (call $wfirst))
      (call $dropr (global.get $r))
      (call $cw (global.get $w)))
    (func (export "write-after-cancel-write") (result i32)
      (drop (call $wfirst))
      (drop (call $cw (global.get $w)))
      (call $swrite (global.get $w) (i32.const 64) (i32.const 1)))
    (func (export "inline-write") (result i32) (call $rfirst))
    (func (export "cancel-read-after-copy") (result i32)
      (drop (call $rfirst))
      (call $cr (global.get $r)))
    (func (export "poll-after-cancel-read") (result i32)
      (drop (call $rfirst))
      (drop (call $cr (global.get $r)))
      (call $pollone (global.get $r)))
    (func (export "poll-without-cancel-read") (result i32)
      (drop (call $rfirst))
      (call $pollone (global.get $r)))
    (func (export "cancel-read-after-copy-writer-dropped") (result i32)
      (drop (call $rfirst))
      (call $dropw (global.get $w))
      (call $cr (global.get $r)))
    (func (export "cancel-write-idle") (result i32)
      (call $split (call $snew))
      (call $cw (global.get $w))))
  (core instance $gi (instantiate $gm (with "" (instance (export "mem" (memory $m))
    (export "snew" (func $snew)) (export "sread" (func $sread)) (export "swrite" (func $swrite))
    (export "cr" (func $cr)) (export "cw" (func $cw)) (export "dropr" (func $dropr)) (export "dropw" (func $dropw))
    (export "wsnew" (func $wsnew)) (export "wsjoin" (func $wsjoin)) (export "wspoll" (func $wspoll))))))
  (type $at (func async (result u32)))
  (func (export "inline-read") (type $at) (canon lift (core func $gi "inline-read")))
  (func (export "cancel-write-after-copy") (type $at) (canon lift (core func $gi "cancel-write-after-copy")))
  (func (export "poll-after-cancel-write") (type $at) (canon lift (core func $gi "poll-after-cancel-write")))
  (func (export "poll-without-cancel-write") (type $at) (canon lift (core func $gi "poll-without-cancel-write")))
  (func (export "cancel-write-after-copy-reader-dropped") (type $at)
    (canon lift (core func $gi "cancel-write-after-copy-reader-dropped")))
  (func (export "write-after-cancel-write") (type $at) (canon lift (core func $gi "write-after-cancel-write")))
  (func (export "inline-write") (type $at) (canon lift (core func $gi "inline-write")))
  (func (export "cancel-read-after-copy") (type $at) (canon lift (core func $gi "cancel-read-after-copy")))
  (func (export "poll-after-cancel-read") (type $at) (canon lift (core func $gi "poll-after-cancel-read")))
  (func (export "poll-without-cancel-read") (type $at) (canon lift (core func $gi "poll-without-cancel-read")))
  (func (export "cancel-read-after-copy-writer-dropped") (type $at)
    (canon lift (core func $gi "cancel-read-after-copy-writer-dropped")))
  (func (export "cancel-write-idle") (type $at) (canon lift (core func $gi "cancel-write-idle"))))
